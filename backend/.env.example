# Database
DATABASE_URL="postgresql://evaccin:evaccin_password@localhost:5432/evaccin_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your_jwt_secret_change_in_production"
JWT_REFRESH_SECRET="your_refresh_secret_change_in_production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Application
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Security
BCRYPT_ROUNDS=10

# Notifications
SMS_API_KEY="your_sms_api_key"
SMS_API_URL="https://api.sms-provider.com"
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_PRIVATE_KEY="your_firebase_private_key"
FIREBASE_CLIENT_EMAIL="your_firebase_client_email"

# Rappels automatiques de rendez-vous (scheduler intégré)
REMINDER_ENABLED="true"            # interrupteur global du scheduler
REMINDER_INTERVAL_MINUTES="60"     # fréquence du cycle génération + envoi
REMINDER_WINDOW_HOURS="48"         # fenêtre de rappel : RDV dans les N prochaines heures
REMINDER_RUN_ON_STARTUP="true"     # cycle immédiat ~5 s après le démarrage

# Storage
S3_ENDPOINT="https://your-s3-endpoint.com"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_BUCKET="evaccin-documents"
S3_REGION="us-east-1"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Monitoring
SENTRY_DSN=""
